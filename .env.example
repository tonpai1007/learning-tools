# Copy to .env and fill in your key (or set these as real environment variables).
# Works with any OpenAI-compatible API:
#   - OpenAI:            OPENAI_API_KEY + https://api.openai.com/v1
#   - Local Ollama:      empty key     + http://localhost:11434/v1  (model: llama3.2)
#   - OpenRouter etc.:   your key      + their base_url
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
